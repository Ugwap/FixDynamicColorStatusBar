<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_manage"
        android:label="@string/app_name"
        android:theme="@style/Theme.DynamicStatusBar">

        <!-- Penanda modul untuk LSPosed -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!--
            Scope bawaan: System UI, Settings, dan Launcher langsung tercentang
            otomatis saat modul di-enable di LSPosed Manager.
        -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <!--
            Catatan: meta-data xposedsharedprefs sengaja TIDAK dipakai.
            Di ROM ini LSPosed mengalihkan SharedPreferences modul ke
            /data/misc/apexdata dan SELinux menolak penulisannya, sehingga
            pengaturan tidak pernah tersimpan. Konfigurasi dibaca proses
            aplikasi yang di-hook lewat ordered broadcast (ConfigReceiver).
        -->

        <receiver
            android:name=".ConfigReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ugwap.dynamicstatusbar.action.GET_CONFIG" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!--
                LSPosed Manager membuka layar modul lewat ACTION_MAIN +
                category MODULE_SETTINGS. Filter ini tidak membuat ikon
                launcher, jadi tetap bisa dibuka walau ikon disembunyikan.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
            Ikon launcher dipisah ke alias supaya bisa di-enable/disable dari
            MainActivity tanpa mematikan modul.
        -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_manage"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
