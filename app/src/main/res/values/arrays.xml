<resources>
    <!--
        Scope bawaan modul (meta-data xposedscope). LSPosed otomatis
        mencentang aplikasi di daftar ini saat modul di-enable.

        System UI wajib, karena warna ikon home screen dan kanal langsung
        aplikasi -> SystemUI diproses di sana. Settings ikut supaya layar
        pengaturan langsung benar. Launcher tidak lagi dipakai untuk fitur
        home screen (prosesnya dijalankan hyos_spawner, modul tidak dimuat),
        tetapi tetap didaftarkan untuk kompatibilitas.
    -->
    <string-array name="xposed_scope">
        <item>com.android.systemui</item>
        <item>com.android.settings</item>
        <item>com.miui.home</item>
        <item>com.android.launcher3</item>

